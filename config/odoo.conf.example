[options]

; PostgreSQL
db_host = localhost
db_port = 5432
db_user = your_odoo_db_user
db_password = change_me

; Addons
addons_path = D:\Odoo\odoo\addons,D:\Odoo\AOS\addons

; Web
http_port = 8069

; Security
admin_passwd = change_me

; Runtime
logfile = D:\Odoo\AOS\logs\odoo.log
log_level = info

; Development
proxy_mode = False
