<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_aos_vehicle_list" model="ir.ui.view">
        <field name="name">aos.vehicle.list</field>
        <field name="model">aos.vehicle</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="registration_number"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_aos_vehicle_form" model="ir.ui.view">
        <field name="name">aos.vehicle.form</field>
        <field name="model">aos.vehicle</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="registration_number"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_aos_vehicle" model="ir.actions.act_window">
        <field name="name">Vehicles</field>
        <field name="res_model">aos.vehicle</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
